[Unit]
Description=Back up the containerized Uther tracker
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/kidd/cloudops-lab/demo-toon-tracker
ExecStart=/usr/bin/bash /home/kidd/cloudops-lab/demo-toon-tracker/scripts/backup-container.sh
TimeoutStartSec=120
NoNewPrivileges=true
